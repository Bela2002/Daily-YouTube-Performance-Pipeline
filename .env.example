# Copy to .env and fill in. Never commit .env.

# Google Cloud Console -> APIs & Services -> Credentials -> API key
# (with "YouTube Data API v3" enabled on the project)
YOUTUBE_API_KEY=your-api-key-here

# PostgreSQL connection string. Use Neon's DIRECT connection (Connect -> turn OFF
# "Connection pooling"): the host must NOT contain "-pooler".
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# One or more channels, comma separated. Channel IDs (UC...) or @handles.
YOUTUBE_CHANNELS=@Google,UC_x5XG1OV2P6uZZ5FSM9Ttw

# Optional tuning
LOOKBACK_DAYS=28                 # stats are refreshed for videos published in this window
FETCH_PLAYLISTS=true             # map videos to playlists (extra quota)
MAX_PLAYLISTS_PER_CHANNEL=50
MAX_PAGES_PER_PLAYLIST=10
MAX_UPLOAD_PAGES=100            # 50 uploads/page -> up to 5,000 videos per channel per window
RAW_RETENTION_DAYS=90           # raw API JSON kept this long (0 = forever)
LOG_LEVEL=INFO
